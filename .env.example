# Salin file ini menjadi .env lalu isi kunci API Claude Anda
# (buat di https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Opsional
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium            # low | medium | high
# WHISPER_DEVICE=auto             # auto | cpu | cuda
# YTDLP_COOKIES_FROM_BROWSER=chrome   # untuk video Facebook/Instagram yang butuh login

# Privasi: biarkan HOST=127.0.0.1 agar hanya komputer ini yang bisa membuka.
# Jika ingin membuka dari HP di Wi-Fi yang sama, set HOST=0.0.0.0 DAN isi APP_PASSWORD.
# HOST=127.0.0.1
# PORT=8000
# APP_PASSWORD=
