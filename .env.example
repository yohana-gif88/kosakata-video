# ===== Penerjemah (pilih salah satu, semuanya GRATIS kecuali Claude) =====

# Pilihan 1 - Gemini (gratis, paling akurat untuk slang, butuh internet)
# Buat kunci gratis di https://aistudio.google.com/apikey lalu tempel di sini:
GEMINI_API_KEY=

# Pilihan 2 - Ollama (gratis, 100% offline & pribadi, butuh RAM >= 8 GB)
# Pasang dari https://ollama.com lalu jalankan:  ollama pull qwen2.5:7b
# Kosongkan GEMINI_API_KEY di atas, maka Ollama dipakai otomatis.
# OLLAMA_MODEL=qwen2.5:7b

# Pilihan 3 - Claude (berbayar)
# ANTHROPIC_API_KEY=

# Paksa pilihan tertentu (opsional): gemini | ollama | claude
# LLM_PROVIDER=
# GEMINI_MODEL=gemini-flash-latest

# ===== Lainnya (opsional) =====
# WHISPER_DEVICE=auto                 # auto | cpu | cuda
# YTDLP_COOKIES_FROM_BROWSER=chrome   # untuk video Facebook/Instagram yang butuh login

# Privasi: biarkan HOST=127.0.0.1 agar hanya komputer ini yang bisa membuka.
# Jika ingin membuka dari HP di Wi-Fi yang sama, set HOST=0.0.0.0 DAN isi APP_PASSWORD.
# HOST=127.0.0.1
# PORT=8000
# APP_PASSWORD=
